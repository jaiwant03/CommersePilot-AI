# ==============================================================================
# COMMERCEPILOT AI — SERVER ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# Client Application URL (For CORS allowlist & email action links)
CLIENT_URL=https://app.yourdomain.com

# MongoDB Database URI (Local or MongoDB Atlas cluster connection string)
# e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/commercepilot_ai?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/commercepilot_ai

# JWT Secret for Session Cookie Signing (Use a 64+ char random string)
JWT_SECRET=generate_a_cryptographically_secure_random_string_here

# Groq API Key (For Llama 3.3 70B inference)
GROQ_API_KEY=gsk_your_groq_api_key_here

# n8n Automation Engine Webhooks (Leave blank for local demo simulation mode)
N8N_ORDER_WEBHOOK_URL=https://your-n8n.cloud/webhook/commercepilot/order-analysis
N8N_INVENTORY_WEBHOOK_URL=https://your-n8n.cloud/webhook/commercepilot/inventory-analysis
N8N_DELIVERY_WEBHOOK_URL=https://your-n8n.cloud/webhook/commercepilot/delivery-recovery
N8N_REPORT_WEBHOOK_URL=https://your-n8n.cloud/webhook/commercepilot/daily-report

# Shared Secret for Webhook Signature Verification (X-CommercePilot-Secret header)
N8N_WEBHOOK_SECRET=your_production_n8n_shared_secret

# SMTP Email Configuration (Nodemailer)
# If empty, system runs in safe Simulated Fallback Mode with formatted console logs
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password_or_api_key
EMAIL_FROM="CommercePilot Operations" <no-reply@commercepilot.ai>
